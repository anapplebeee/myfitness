# 临时提交信息
.commitmsg.txt

# 无头浏览器调试目录（任何以 .edge- 开头）
.edge-*/

# Playwright 产物
test-results/
playwright-report/
blob-report/
playwright/.cache/

# 本地构建的测试包，不入库（体积大且可随时重建）
dist-apk/*.apk


# 真机 WebView 数据备份（含真实用户数据，禁止入库）
.phone-backup*.tar

# 测试运行期临时目录
.tmp/

# 商业云后端运行时数据（单机文件存储）
var/
