{
  "name": "tieguan",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "铁馆 · 力量训练与饮食记录（本地优先）",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "verify": "npm run typecheck && npm run typecheck:e2e && npm run test && npm run build",
    "android:check": "node scripts/check-android.mjs",
    "android:sync": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "5.2.1",
    "@vitest/coverage-v8": "^3.0.5",
    "typescript": "5.7.2",
    "vite": "6.0.5",
    "vitest": "^3.0.5",
    "vue-tsc": "2.2.0"
  }
}
