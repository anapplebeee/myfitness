<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 及以下的备份排除规则（AC-C07）。
    即使 allowBackup=false，显式排除也能表达意图，
    并防止厂商 ROM 忽略该属性时误备份。
-->
<full-backup-content>
    <!-- WebView 数据：IndexedDB 里是全部业务数据 -->
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="app_webview" />
    <exclude domain="file" path="databases" />
</full-backup-content>
